---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { AGENTS, AGENTS_LAST_UPDATED, LAYERS } from "../data/agents.js";
import kaiOsData from "../data/generated/kai-os-public-data.json";

const LAST_UPDATED = AGENTS_LAST_UPDATED;
const { total_capabilities, capability_status_counts } = kaiOsData.agents;
const { production } = kaiOsData;

// Slugs with a matching node in AgentEcosystem.astro's real pipeline flow
// (verified by direct cross-reference against that component's FLOW array).
// Not every agent appears there -- only the ones the real pipeline actually
// reaches today (Operational agents) plus the two Planned ones that already
// have a labeled "planned connection" node (Analytics, Knowledge).
const ECOSYSTEM_SLUGS = new Set(["visual", "voice", "music", "thumbnail", "compliance", "analytics", "knowledge"]);

function statusClass(status: string) {
  if (status === "Operational") return "status-pill--operational";
  if (status === "In Development") return "status-pill--in-development";
  if (status === "Coming Soon") return "status-pill--coming-soon";
  return "status-pill--planned";
}

// AI Agent Network (Website Next Phase, Step 3) -- a product-facing,
// conceptual view of what KAI's agent ecosystem could grow into,
// distinct from the technical sub_agents.py registry rendered below.
// Deliberately not a duplicate: where a conceptual role already has a
// real, declared technical counterpart (Research, Analytics), its card
// links down to that real card instead of re-describing it differently.
// Everything without existing code is honestly Planned -- none of this
// implies a new backend agent was built; this section is presentation
// only, per this step's explicit "public website representation only" scope.
const AGENT_NETWORK = [
  {
    name: "YouTube / Content", tier: "status-operational", label: "Operational",
    mission: `Researches, writes, assembles, and publishes videos end-to-end. ${production.completed_total} real uploads to date.`,
    link: { href: "/status", text: "See production status" },
  },
  {
    name: "Research", tier: "status-planned", label: "Planned",
    mission: "Would source, verify, and summarize information to feed future pages like AI News and Future Radar.",
    link: { href: "#sub-agent-research", text: "See the declared technical agent" },
  },
  {
    name: "News", tier: "status-planned", label: "Planned",
    mission: "Would discover and summarize AI news automatically. A hand-curated AI News Center is already live -- this agent would only automate how it grows and keep it current.",
    link: { href: "/ai-news", text: "See the curated collection" },
  },
  {
    name: "Community", tier: "status-planned", label: "Planned",
    mission: "Would power future discussion and community features. No backend, no accounts, no stored comments exist today -- comment UI is live across the Media Network, but nothing typed into it is saved.",
    link: { href: "/media", text: "Explore the Media Network" },
  },
  {
    name: "Comment", tier: "status-planned", label: "Planned",
    mission: "Would draft on-brand reply suggestions for human review -- never auto-posts. Not yet started; the full design (intent detection, tone, mandatory human approval) is documented.",
    link: { href: "/command-center#comment-assistant", text: "See the Comment Assistant design" },
  },
  {
    name: "Future Radar", tier: "status-planned", label: "Planned",
    mission: "Would research and maintain a future-technology signal set automatically. A hand-curated Future Radar is already live -- this agent would only automate how it updates.",
    link: { href: "/future-radar", text: "See the live radar" },
  },
  {
    name: "Fun Facts", tier: "status-planned", label: "Planned",
    mission: "Would automatically source and verify new AI facts. A small, hand-curated collection is already live -- this agent would only automate how it grows.",
    link: { href: "/fun-facts", text: "See the live collection" },
  },
  {
    name: "Joke", tier: "status-planned", label: "Planned",
    mission: "Would automatically curate new AI jokes. A small, hand-curated collection is already live -- this agent would only automate how it grows.",
    link: { href: "/ai-jokes", text: "See the live collection" },
  },
  {
    name: "Analytics", tier: "status-planned", label: "Planned",
    mission: "Would track and interpret real production/YouTube performance beyond today's view/like/comment counts.",
    link: { href: "#sub-agent-analytics", text: "See the declared technical agent" },
  },
  {
    name: "Affiliate", tier: "status-planned", label: "Planned",
    mission: "Future capability for identifying and managing affiliate revenue opportunities. Not yet started.",
    link: null,
  },
  {
    name: "Digital Products", tier: "status-planned", label: "Planned",
    mission: "Future capability for building and managing digital products. Not yet started.",
    link: null,
  },
  {
    name: "Freelance", tier: "status-planned", label: "Planned",
    mission: "Future capability for sourcing and completing freelance work. Not yet started.",
    link: null,
  },
  {
    name: "Remote Job", tier: "status-planned", label: "Planned",
    mission: "Future capability for identifying remote work opportunities. Not yet started.",
    link: null,
  },
  {
    name: "Trading", tier: "status-planned", label: "Planned",
    mission: "A separate, independent trading system already exists in the KAI OS backend. It is not connected to this website, shows no live data here, and stays out of scope until a separate integration project explicitly authorizes it.",
    link: null,
  },
  {
    name: "Web3", tier: "status-planned", label: "Planned",
    mission: "Future capability for on-chain / decentralized-web interaction. Not yet started.",
    link: null,
  },
  {
    name: "Content Router", tier: "status-operational", label: "Operational",
    mission: "Deterministically assigns any content category to ProjectKAIAI or Project Kai AI Lessons, with a stated reason -- real and running today, not a placeholder.",
    link: { href: "/media", text: "See the router demo" },
  },
  {
    name: "Recommendation", tier: "status-operational", label: "Operational",
    mission: "Surprise Me and What Should I Explore both run today over the real content index -- deterministic, not machine-learned. A smarter, personalization-aware version remains Planned.",
    link: { href: "/media", text: "Try the recommenders" },
  },
];
---

<Layout
  title="The Project KAI Agent Network | 13 Real Agents"
  description="The complete, real Project KAI agent architecture -- 13 specialized agents, each with an honest Capability Status and Autonomous Agent Status."
  canonicalPath="/agents"
>
  <Header />

  <main id="main-content" class="page-main">
    <section class="page-hero">
      <div class="container">
        <p class="page-kicker">AI Agent Ecosystem</p>
        <h1 class="page-title">The complete Project KAI agent architecture -- 13 agents, honestly labeled.</h1>
        <p class="page-lede">
          Every agent below is real and documented in the Project KAI codebase
          (<code>sub_agents/agents.py</code>). Two statuses are shown for each, on purpose:
          <strong>Capability Status</strong> -- is the underlying work actually happening in
          production today -- and <strong>Autonomous Agent Status</strong> -- is it running as
          a standalone, callable agent yet. Those are different questions. Several capabilities
          already run automatically today as inline pipeline logic; none of them run yet as
          independent autonomous agents (<code>SubAgentSkeleton.execute()</code> raises
          <code>NotImplementedError</code> unconditionally, for all 13, by design).
        </p>
      </div>
    </section>

    <section class="page-section verified-summary">
      <div class="container">
        <p class="verified-summary-text">
          <strong>{total_capabilities} agents</strong> cross-checked against <code>sub_agents/agents.py</code> at
          the last data sync —
          <strong>{capability_status_counts["Operational"] ?? 0} Operational</strong>,
          <strong>{capability_status_counts["Planned"] ?? 0} Planned</strong>,
          <strong>{capability_status_counts["Coming Soon"] ?? 0} Coming Soon</strong>.
          {kaiOsData.note}
        </p>
      </div>
    </section>

    <section class="page-section network-section">
      <div class="container">
        <div class="section-center">
          <div class="section-badge">AI Agent Network</div>
          <h2 class="section-title">Where the agent ecosystem is headed.</h2>
          <p class="section-subtitle">
            A product-facing view of the roles KAI's agent ecosystem could grow into -- distinct
            from the technical registry below. Only YouTube / Content is real today; everything
            else is honestly Planned, with no fabricated capability or timeline.
          </p>
        </div>

        <div class="network-grid">
          {AGENT_NETWORK.map((item) => (
            <article class="content-card network-card">
              <div class="network-card-head">
                <h3>{item.name}</h3>
                <span class={`status-badge ${item.tier}`}>{item.label}</span>
              </div>
              <p>{item.mission}</p>
              {item.link && <a class="network-card-link" href={item.link.href}>{item.link.text} →</a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    {LAYERS.map((layer) => {
      const layerAgents = AGENTS.filter((agent) => agent.layer === layer.key);
      if (!layerAgents.length) return null;
      return (
        <section class="page-section agent-layer-section">
          <div class="container">
            <div class="agent-layer-heading">
              <h2>{layer.label}</h2>
              <span class="agent-layer-count">{layerAgents.length} agent{layerAgents.length === 1 ? "" : "s"}</span>
            </div>
            <div class="agents-full-grid">
              {layerAgents.map((agent) => (
                <article class="content-card agent-detail-card" id={`sub-agent-${agent.slug}`}>
                  <div class="agent-status-row">
                    <div class="agent-status-item">
                      <span class="agent-status-label">Capability</span>
                      <span class={`status-pill ${statusClass(agent.capabilityStatus)}`}>{agent.capabilityStatus}</span>
                    </div>
                    <div class="agent-status-item">
                      <span class="agent-status-label">Autonomous Agent</span>
                      <span class={`status-pill ${statusClass(agent.agentStatus)}`}>{agent.agentStatus}</span>
                    </div>
                  </div>

                  <h3>{agent.name}</h3>
                  <p class="agent-purpose">{agent.purpose}</p>

                  <dl class="agent-fields">
                    <dt>Inputs</dt>
                    <dd>{agent.inputs}</dd>

                    <dt>Outputs</dt>
                    <dd>{agent.outputs}</dd>

                    <dt>Dependencies</dt>
                    <dd>{agent.dependencies}</dd>

                    <dt>Current Capability</dt>
                    <dd>{agent.currentCapability}</dd>

                    <dt>Automation Level</dt>
                    <dd>{agent.automationLevel}</dd>

                    <dt>Roadmap</dt>
                    <dd>{agent.roadmap}</dd>
                  </dl>

                  <p class="agent-updated">Last updated: {LAST_UPDATED}</p>

                  {ECOSYSTEM_SLUGS.has(agent.slug) && (
                    <a href={`/#ecosystem-${agent.slug}`} class="agent-ecosystem-link">See this in the pipeline flow →</a>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </main>

  <Footer />
</Layout>

<style>
.network-section {
  padding-bottom: 24px;
}

.network-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.network-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.network-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}

.network-card-head h3 {
  margin: 0;
  font-size: 16px;
}

.network-card p {
  margin: 0;
  color: var(--text-soft);
  font-size: 13.5px;
  line-height: 1.65;
  flex-grow: 1;
}

.network-card-link {
  color: var(--primary);
  font-size: 12.5px;
  font-weight: 700;
}

.network-card-link:hover {
  text-decoration: underline;
}

@media (max-width: 1100px) {
  .network-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .network-grid {
    grid-template-columns: 1fr;
  }
}

.agent-layer-section {
  padding-top: 0;
  padding-bottom: 56px;
}

.agent-layer-section:last-of-type {
  padding-bottom: var(--section-padding);
}

.agent-layer-heading {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.agent-layer-heading h2 {
  margin: 0;
  font-size: 22px;
}

.agent-layer-count {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.verified-summary {
  padding-top: 0;
  padding-bottom: 40px;
}

.verified-summary-text {
  max-width: 760px;
  margin: 0 auto;
  padding: 16px 20px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: rgba(15, 23, 42, 0.5);
  color: var(--text-soft);
  font-size: 14px;
  line-height: 1.7;
  text-align: center;
}

.verified-summary-text code {
  font-family: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas, monospace;
  color: var(--text-main);
}

.agents-full-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.agent-detail-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-content: start;
}

.agent-status-row {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.agent-status-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.agent-status-label {
  color: var(--text-muted);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.agent-detail-card h2 {
  margin: 0;
}

.agent-purpose {
  color: var(--text-soft);
}

.agent-fields {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 10px 16px;
  margin: 0;
}

.agent-fields dt {
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.agent-fields dd {
  margin: 0;
  color: var(--text-soft);
  font-size: 0.92rem;
  line-height: 1.6;
}

.agent-updated {
  margin: 4px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  font-size: 0.82rem;
  color: var(--text-muted);
}

.agent-ecosystem-link {
  display: inline-block;
  margin-top: 8px;
  color: var(--primary);
  font-size: 13px;
  font-weight: 700;
}

.agent-ecosystem-link:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .agents-full-grid {
    grid-template-columns: 1fr;
  }

  .agent-fields {
    grid-template-columns: 1fr;
    gap: 4px 0;
  }

  .agent-fields dd {
    margin-bottom: 8px;
  }
}
</style>
