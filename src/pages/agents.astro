---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { AGENTS, AGENTS_LAST_UPDATED, LAYERS } from "../data/agents.js";
import kaiOsData from "../data/generated/kai-os-public-data.json";
import { PRODUCT_SYSTEMS } from "../data/product.js";

const LAST_UPDATED = AGENTS_LAST_UPDATED;
const { total_capabilities, capability_status_counts } = kaiOsData.agents;

// Slugs with a matching node in AgentEcosystem.astro's real pipeline flow
// (verified by direct cross-reference against that component's FLOW array).
// Not every agent appears there -- only the ones the real pipeline actually
// reaches today inside the real content-production flow.
const ECOSYSTEM_SLUGS = new Set(["visual", "voice", "music", "thumbnail", "compliance"]);

function statusClass(status: string) {
  if (status === "Operational") return "status-pill--operational";
  if (status === "In Development") return "status-pill--in-development";
  if (status === "Coming Soon") return "status-pill--coming-soon";
  return "status-pill--planned";
}

// Product-facing systems are distinct from the 13 declared technical
// SubAgentSkeleton roles below. The split avoids promoting inert scaffolding
// while still showing the real orchestration adapters and domain systems.
const AGENT_NETWORK = PRODUCT_SYSTEMS.map((system) => ({
  name: system.title,
  tier: system.tier,
  label: system.status,
  mission: system.description,
  link:
    system.code === "PROD" ? { href: "/#ecosystem", text: "See the content flow" }
    : system.code === "KNOW" ? { href: "/knowledge", text: "Open Knowledge Brain" }
    : system.code === "TRD" ? { href: "/#trading", text: "Review the paper-only boundary" }
    : system.code === "DESK" ? { href: "/desktop-operator", text: "Review the control architecture" }
    : { href: "/#capabilities", text: "See verified capabilities" },
}));
---

<Layout
  title="Project KAI Agent & Intelligence Ecosystem | Honest Status"
  description="Project KAI's operational systems and 13 declared technical agent roles, with capability status, autonomous-agent status, and development boundaries kept separate."
  canonicalPath="/agents"
>
  <Header />

  <main id="main-content" class="page-main">
    <section class="page-hero">
      <div class="container">
        <p class="page-kicker">AI Agent Ecosystem</p>
        <h1 class="page-title">Specialized intelligence, with capability and autonomy kept separate.</h1>
        <p class="page-lede">
          KAI includes real domain systems and a separate registry of 13 declared technical
          agent roles. The product systems are shown first. The registry below then exposes two
          statuses for each declared role, on purpose: {" "}
          <strong>Capability Status</strong> -- is the underlying work actually happening in
          production today -- and <strong>Autonomous Agent Status</strong> -- is it running as
          the declared standalone agent yet. Several capabilities run as pipeline stages or
          bounded orchestration adapters, while the 13 SubAgentSkeleton roles remain scaffolding.
        </p>
      </div>
    </section>

    <section class="page-section verified-summary">
      <div class="container">
        <p class="verified-summary-text">
          <strong>{total_capabilities} agents</strong> cross-checked against the declared registry at
          the last data sync — {" "}
          <strong>{capability_status_counts["Operational"] ?? 0} Operational</strong>, {" "}
          <strong>{capability_status_counts["Planned"] ?? 0} Planned</strong>, and {" "}
          <strong>{capability_status_counts["Coming Soon"] ?? 0} Coming Soon</strong>. {" "}
          {kaiOsData.note}
        </p>
      </div>
    </section>

    <section class="page-section network-section">
      <div class="container">
        <div class="section-center">
          <div class="section-badge">Operational System Map</div>
          <h2 class="section-title">The intelligence KAI can actually coordinate.</h2>
          <p class="section-subtitle">
            These are real product-level systems, distinct from the technical registry below.
            Their status reflects bounded capability today—not a claim of unrestricted autonomy.
          </p>
        </div>

        <div class="network-grid">
          {AGENT_NETWORK.map((item) => (
            <article class="content-card network-card">
              <div class="network-card-head">
                <h3>{item.name}</h3>
                <span class={`status-badge ${item.tier}`}>{item.label}</span>
              </div>
              <p>{item.mission}</p>
              {item.link && <a class="network-card-link" href={item.link.href}>{item.link.text} →</a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    {LAYERS.map((layer) => {
      const layerAgents = AGENTS.filter((agent) => agent.layer === layer.key);
      if (!layerAgents.length) return null;
      return (
        <section class="page-section agent-layer-section">
          <div class="container">
            <div class="agent-layer-heading">
              <h2>{layer.label}</h2>
              <span class="agent-layer-count">{layerAgents.length} agent{layerAgents.length === 1 ? "" : "s"}</span>
            </div>
            <div class="agents-full-grid">
              {layerAgents.map((agent) => (
                <article class="content-card agent-detail-card" id={`sub-agent-${agent.slug}`}>
                  <div class="agent-status-row">
                    <div class="agent-status-item">
                      <span class="agent-status-label">Capability</span>
                      <span class={`status-pill ${statusClass(agent.capabilityStatus)}`}>{agent.capabilityStatus}</span>
                    </div>
                    <div class="agent-status-item">
                      <span class="agent-status-label">Autonomous Agent</span>
                      <span class={`status-pill ${statusClass(agent.agentStatus)}`}>{agent.agentStatus}</span>
                    </div>
                  </div>

                  <h3>{agent.name}</h3>
                  <p class="agent-purpose">{agent.purpose}</p>

                  <dl class="agent-fields">
                    <dt>Inputs</dt>
                    <dd>{agent.inputs}</dd>

                    <dt>Outputs</dt>
                    <dd>{agent.outputs}</dd>

                    <dt>Dependencies</dt>
                    <dd>{agent.dependencies}</dd>

                    <dt>Current Capability</dt>
                    <dd>{agent.currentCapability}</dd>

                    <dt>Automation Level</dt>
                    <dd>{agent.automationLevel}</dd>

                    <dt>Roadmap</dt>
                    <dd>{agent.roadmap}</dd>
                  </dl>

                  <p class="agent-updated">Last updated: {LAST_UPDATED}</p>

                  {ECOSYSTEM_SLUGS.has(agent.slug) && (
                    <a href={`/#ecosystem-${agent.slug}`} class="agent-ecosystem-link">See this in the pipeline flow →</a>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </main>

  <Footer />
</Layout>

<style>
.network-section {
  padding-bottom: 24px;
}

.network-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.network-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.network-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}

.network-card-head h3 {
  margin: 0;
  font-size: 16px;
}

.network-card p {
  margin: 0;
  color: var(--text-soft);
  font-size: 13.5px;
  line-height: 1.65;
  flex-grow: 1;
}

.network-card-link {
  color: var(--primary);
  font-size: 12.5px;
  font-weight: 700;
}

.network-card-link:hover {
  text-decoration: underline;
}

@media (max-width: 1100px) {
  .network-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .network-grid {
    grid-template-columns: 1fr;
  }
}

.agent-layer-section {
  padding-top: 0;
  padding-bottom: 56px;
}

.agent-layer-section:last-of-type {
  padding-bottom: var(--section-padding);
}

.agent-layer-heading {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.agent-layer-heading h2 {
  margin: 0;
  font-size: 22px;
}

.agent-layer-count {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.verified-summary {
  padding-top: 0;
  padding-bottom: 40px;
}

.verified-summary-text {
  max-width: 760px;
  margin: 0 auto;
  padding: 16px 20px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: rgba(15, 23, 42, 0.5);
  color: var(--text-soft);
  font-size: 14px;
  line-height: 1.7;
  text-align: center;
}

.verified-summary-text code {
  font-family: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas, monospace;
  color: var(--text-main);
}

.agents-full-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.agent-detail-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-content: start;
}

.agent-status-row {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.agent-status-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.agent-status-label {
  color: var(--text-muted);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.agent-detail-card h2 {
  margin: 0;
}

.agent-purpose {
  color: var(--text-soft);
}

.agent-fields {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 10px 16px;
  margin: 0;
}

.agent-fields dt {
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.agent-fields dd {
  margin: 0;
  color: var(--text-soft);
  font-size: 0.92rem;
  line-height: 1.6;
}

.agent-updated {
  margin: 4px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  font-size: 0.82rem;
  color: var(--text-muted);
}

.agent-ecosystem-link {
  display: inline-block;
  margin-top: 8px;
  color: var(--primary);
  font-size: 13px;
  font-weight: 700;
}

.agent-ecosystem-link:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .agents-full-grid {
    grid-template-columns: 1fr;
  }

  .agent-fields {
    grid-template-columns: 1fr;
    gap: 4px 0;
  }

  .agent-fields dd {
    margin-bottom: 8px;
  }
}
</style>
