---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { AGENTS, AGENTS_LAST_UPDATED } from "../data/agents.js";

const LAST_UPDATED = AGENTS_LAST_UPDATED;

function statusClass(status: string) {
  if (status === "Operational") return "status-pill--operational";
  if (status === "In Development") return "status-pill--in-development";
  if (status === "Coming Soon") return "status-pill--coming-soon";
  return "status-pill--planned";
}
---

<Layout
  title="All 13 KAI OS Agents | Project KAI"
  description="The complete, real KAI OS agent architecture -- 13 specialized agents, each with an honest Capability Status and Autonomous Agent Status."
  canonicalPath="/agents"
>
  <Header />

  <main id="main-content" class="page-main">
    <section class="page-hero">
      <div class="container">
        <p class="page-kicker">AI Agent Ecosystem</p>
        <h1 class="page-title">The complete KAI OS agent architecture -- 13 agents, honestly labeled.</h1>
        <p class="page-lede">
          Every agent below is real and documented in the KAI OS codebase
          (<code>sub_agents/agents.py</code>). Two statuses are shown for each, on purpose:
          <strong>Capability Status</strong> -- is the underlying work actually happening in
          production today -- and <strong>Autonomous Agent Status</strong> -- is it running as
          a standalone, callable agent yet. Those are different questions. Several capabilities
          already run automatically today as inline pipeline logic; none of them run yet as
          independent autonomous agents (<code>SubAgentSkeleton.execute()</code> raises
          <code>NotImplementedError</code> unconditionally, for all 13, by design).
        </p>
      </div>
    </section>

    <section class="page-section">
      <div class="container agents-full-grid">
        {AGENTS.map((agent) => (
          <article class="content-card agent-detail-card">
            <div class="agent-status-row">
              <div class="agent-status-item">
                <span class="agent-status-label">Capability</span>
                <span class={`status-pill ${statusClass(agent.capabilityStatus)}`}>{agent.capabilityStatus}</span>
              </div>
              <div class="agent-status-item">
                <span class="agent-status-label">Autonomous Agent</span>
                <span class={`status-pill ${statusClass(agent.agentStatus)}`}>{agent.agentStatus}</span>
              </div>
            </div>

            <h2>{agent.name}</h2>
            <p class="agent-purpose">{agent.purpose}</p>

            <dl class="agent-fields">
              <dt>Inputs</dt>
              <dd>{agent.inputs}</dd>

              <dt>Outputs</dt>
              <dd>{agent.outputs}</dd>

              <dt>Dependencies</dt>
              <dd>{agent.dependencies}</dd>

              <dt>Current Capability</dt>
              <dd>{agent.currentCapability}</dd>

              <dt>Automation Level</dt>
              <dd>{agent.automationLevel}</dd>

              <dt>Roadmap</dt>
              <dd>{agent.roadmap}</dd>
            </dl>

            <p class="agent-updated">Last updated: {LAST_UPDATED}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
.agents-full-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.agent-detail-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-content: start;
}

.agent-status-row {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.agent-status-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.agent-status-label {
  color: var(--text-muted);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.agent-detail-card h2 {
  margin: 0;
}

.agent-purpose {
  color: var(--text-soft);
}

.agent-fields {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 10px 16px;
  margin: 0;
}

.agent-fields dt {
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.agent-fields dd {
  margin: 0;
  color: var(--text-soft);
  font-size: 0.92rem;
  line-height: 1.6;
}

.agent-updated {
  margin: 4px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  font-size: 0.82rem;
  color: var(--text-muted);
}

@media (max-width: 900px) {
  .agents-full-grid {
    grid-template-columns: 1fr;
  }

  .agent-fields {
    grid-template-columns: 1fr;
    gap: 4px 0;
  }

  .agent-fields dd {
    margin-bottom: 8px;
  }
}
</style>
