---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Agents from "../components/Agents.astro";
import AgentEcosystem from "../components/AgentEcosystem.astro";
import HowKaiWorks from "../components/HowKaiWorks.astro";
import InsideKai from "../components/InsideKai.astro";
import Founder from "../components/Founder.astro";
