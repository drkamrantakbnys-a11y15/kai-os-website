  description="Project KAI is a local-first, human-controlled AI operating system connecting specialized intelligence, memory, research, content automation, voice, governance, and paper-trading systems."
  canonicalPath="/"
>
  <Header />
  <main id="main-content">
    <Hero />
    <Stats />
    <CapabilitiesToday />
    <Agents />
    <VoiceConversation />
    <AgentEcosystem />
    <TradingIntelligence />
    <HowKaiWorks />
    <TrustTransparency />
    <MemoryOrchestration />
    <Research />
    <DocumentationPreview />
    <Roadmap />
    <Founder />
    <SupportKai />
    <Community />
  </main>
  <Footer />
  <VisionVideoModal />
</Layout>
