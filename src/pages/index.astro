---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import CapabilitiesToday from "../components/CapabilitiesToday.astro";
import Agents from "../components/Agents.astro";
import VoiceConversation from "../components/VoiceConversation.astro";
import AgentEcosystem from "../components/AgentEcosystem.astro";
import TradingIntelligence from "../components/TradingIntelligence.astro";
import HowKaiWorks from "../components/HowKaiWorks.astro";
import TrustTransparency from "../components/TrustTransparency.astro";
import MemoryOrchestration from "../components/MemoryOrchestration.astro";
import DocumentationPreview from "../components/DocumentationPreview.astro";
import Research from "../components/Research.astro";
import Roadmap from "../components/Roadmap.astro";
import Founder from "../components/Founder.astro";
import SupportKai from "../components/SupportKai.astro";
import Community from "../components/Community.astro";
import Footer from "../components/Footer.astro";
import VisionVideoModal from "../components/VisionVideoModal.astro";
---

<Layout
