---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import MediaNetworkPreview from "../components/MediaNetworkPreview.astro";
import Agents from "../components/Agents.astro";
import AgentEcosystem from "../components/AgentEcosystem.astro";
import HowKaiWorks from "../components/HowKaiWorks.astro";
import Founder from "../components/Founder.astro";
import TrustTransparency from "../components/TrustTransparency.astro";
import DocumentationPreview from "../components/DocumentationPreview.astro";
import Research from "../components/Research.astro";
import Roadmap from "../components/Roadmap.astro";
import Features from "../components/Features.astro";
import Community from "../components/Community.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Project KAI | Discover AI, Technology, Science & the Future"
  description="Project KAI is an AI, technology, and discovery media platform -- news, future radar, experiments, reviews, and education, powered by KAI OS, its modular AI operating system."
  canonicalPath="/"
>
  <Header />
  <main id="main-content">
    <Hero />
    <Stats />
    <MediaNetworkPreview />
    <About />
    <AgentEcosystem />
    <HowKaiWorks />
    <Founder />
    <TrustTransparency />
    <DocumentationPreview />
    <Agents />
    <Research />
    <Features />
    <Roadmap />
    <Community />
    <CTA />
  </main>
  <Footer />
</Layout>
