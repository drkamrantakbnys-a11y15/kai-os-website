---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImagePath?: string;
  noindex?: boolean;
}

const {
  title = "Project KAI | Discover AI, Technology, Science & the Future",
  description = "Project KAI is an AI, technology, and discovery media platform -- news, future radar, experiments, reviews, and education, powered by KAI OS, its modular AI operating system.",
  canonicalPath = "/",
  ogImagePath = "/og-image.png",
  noindex = false
} = Astro.props;

const canonicalUrl = canonicalPath === "/"
  ? "https://projectkai.dev/"
  : `https://projectkai.dev${canonicalPath}`;

const ogImageUrl = `https://projectkai.dev${ogImagePath}`;
---

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="theme-color"
    content="#050b18"
  />

  <meta
    name="robots"
    content={noindex ? "noindex, nofollow" : "index, follow"}
  />

  <link
    rel="canonical"
    href={canonicalUrl}
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonicalUrl}
  />

  <meta
    property="og:type"
    content="website"
  />

  <meta
    property="og:site_name"
    content="Project KAI"
  />

  <meta
    property="og:image"
    content={ogImageUrl}
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />

  <meta
    property="og:image:alt"
    content="Project KAI — discover AI, technology, science, and the future."
  />

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={ogImageUrl}
  />

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />

  <link
    rel="icon"
    href="/favicon.ico"
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Project KAI",
    "url": "https://projectkai.dev/",
    "description": "Project KAI is an AI, technology, and discovery media platform -- news, future radar, experiments, reviews, and education, powered by KAI OS, its modular AI operating system.",
    "founder": {
      "@type": "Person",
      "name": "Kamran Tak",
      "jobTitle": "Founder and Architect"
    }
  })} />

  <script is:inline>document.documentElement.classList.add("js");</script>

</head>

<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <slot />

  <script src="../scripts/interactions.js"></script>

  <script>
    import { trackPageView } from "../lib/analytics.js";
    trackPageView(window.location.pathname);
  </script>

</body>

</html>
