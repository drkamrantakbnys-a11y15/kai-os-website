---
// Homepage Media Network teaser (Media Network + Engagement Expansion,
// Section 41). Added as a new preview module alongside the homepage's
// existing DocumentationPreview pattern, rather than rewriting Hero's
// already fact-checked copy -- see Section 2's "never rewrite the
// entire website unnecessarily."
import { CHANNELS } from "../data/channels.js";
import TrendingPicks from "./TrendingPicks.astro";

const FEATURES = [
  { label: "Discover", href: "/discover", note: "Stories, facts, and format-tagged documentaries." },
  { label: "Learning Paths", href: "/learn", note: "Structured AI curriculum, routed to Project Kai AI Lessons." },
  { label: "Watch", href: CHANNELS[0].url, note: "The primary discovery channel on YouTube." },
  { label: "Future Radar", href: "/future-radar", note: "Emerging tech, honestly labeled as estimate." },
  { label: "AI Facts", href: "/fun-facts", note: "Short, sourced facts about AI and computing." },
  { label: "AI Jokes", href: "/ai-jokes", note: "A small, curated joke collection." },
  { label: "Latest News", href: "/ai-news", note: "Curated, sourced AI and technology news." },
  { label: "Experiments", href: "/experiments", note: "Questions we're testing -- honestly labeled." },
  { label: "Gadgets & Apps", href: "/reviews", note: "AI apps and gadgets, honestly labeled by testing depth." },
  { label: "Community", href: "/media", note: "Comments, reactions, and the KAI Assistant, all in one hub." },
];
---

<section class="media-preview" id="media-network">
  <div class="container">
    <div class="section-center">
      <div class="section-badge">KAI Media Network</div>
      <h2 class="section-title">Explore AI. Discover technology. Imagine the future.</h2>
      <p class="section-subtitle">
        Two real YouTube channels and this website, working as one ecosystem.
      </p>
    </div>

    <div class="media-preview-trending">
      <TrendingPicks />
    </div>

    <div class="media-preview-grid">
      {FEATURES.map((f) => (
        <a href={f.href} class="content-card media-preview-card" target={f.href.startsWith("http") ? "_blank" : undefined} rel={f.href.startsWith("http") ? "noopener noreferrer" : undefined}>
          <h3>{f.label}</h3>
          <p>{f.note}</p>
        </a>
      ))}
    </div>

    <div class="media-preview-channels">
      {CHANNELS.map((ch) => (
        <a href={ch.url} target="_blank" rel="noopener noreferrer" class="content-card media-preview-channel-card">
          <span class="media-preview-channel-role">{ch.role}</span>
          <strong>{ch.name}</strong>
          <span class="media-preview-channel-tagline">{ch.tagline}</span>
        </a>
      ))}
    </div>

    <div class="media-preview-cta">
      <a href="/media" class="primary-button">Visit the Media Network Hub →</a>
    </div>
  </div>
</section>

<style>
.media-preview {
  background:
    radial-gradient(circle at 25% 15%, rgba(129, 140, 248, 0.07), transparent 32%),
    linear-gradient(180deg, #08111f 0%, #050b18 100%);
}

.media-preview-trending {
  margin-bottom: 48px;
}

.media-preview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 36px;
}

.media-preview-card {
  display: block;
  text-align: left;
}

.media-preview-card h3 {
  margin: 0 0 8px;
  font-size: 16px;
  color: var(--text-main);
}

.media-preview-card p {
  margin: 0;
  color: var(--text-muted);
  font-size: 12.5px;
  line-height: 1.6;
}

.media-preview-channels {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  max-width: 640px;
  margin: 0 auto 36px;
}

.media-preview-channel-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: center;
  align-items: center;
}

.media-preview-channel-role {
  color: var(--text-muted);
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.media-preview-channel-card strong {
  color: var(--text-main);
  font-size: 16px;
}

.media-preview-channel-tagline {
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
}

.media-preview-cta {
  display: flex;
  justify-content: center;
}

@media (max-width: 560px) {
  .media-preview-channels {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 1100px) {
  .media-preview-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 560px) {
  .media-preview-grid {
    grid-template-columns: 1fr;
  }
}
</style>
