---
const PILLARS = [
  { code: "HUM", title: "Human Review", body: "Content publishing and consequential activation decisions remain explicit human checkpoints, not unattended defaults." },
  { code: "POL", title: "Permission Gates", body: "Capabilities are authorized narrowly. Policy, owner state, and approval requirements are checked before controlled execution." },
  { code: "PPR", title: "Paper-First Finance", body: "Trading intelligence is validated against paper brokerage infrastructure before any broader activation is considered." },
  { code: "STOP", title: "Kill Switches & Pause", body: "Independent stop controls, global pause, and emergency state provide more than one way to prevent new consequential work." },
  { code: "RISK", title: "Risk Governance", body: "Daily loss, exposure, drawdown, position, and exit protections sit inside the trading evaluation path—not outside it." },
  { code: "AUD", title: "Auditability", body: "Decisions, failures, evidence, and outcomes are recorded so safety and product claims can be reviewed rather than assumed." },
  { code: "LOC", title: "Local-First Processing", body: "Core conversational and operational paths prioritize the owner's environment and bounded local fallbacks." },
  { code: "PRIV", title: "Public-Safe Disclosure", body: "The website explains principles and status without publishing credentials, account details, private runtime paths, or security-sensitive configuration.", link: { href: "/privacy", text: "Read the privacy policy" } },
];
---

<section class="trust" id="trust">
  <div class="container">
    <div class="trust-heading">
      <div>
        <div class="section-badge">Safety by Design</div>
        <h2 class="section-title">Capability without invisible authority.</h2>
      </div>
      <p class="section-subtitle">
        KAI is designed around a simple rule: more consequential work gets stricter gates.
        Safety is expressed through operating controls, human checkpoints, and evidence—not
        through a promise of perfect autonomy.
      </p>
    </div>

    <div class="trust-grid">
      {PILLARS.map((pillar) => (
        <article class="trust-card">
          <span class="trust-code" aria-hidden="true">{pillar.code}</span>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
          {pillar.link && <a href={pillar.link.href} class="trust-link">{pillar.link.text} →</a>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.trust { background: radial-gradient(circle at 20% 15%, rgba(56, 189, 248, 0.06), transparent 32%), linear-gradient(180deg, var(--bg-main), var(--bg-section)); }
.trust-heading { display: grid; grid-template-columns: 1fr 0.8fr; gap: 64px; align-items: end; margin-bottom: 58px; }
.trust-heading .section-title { margin-bottom: 0; }
.trust-heading .section-subtitle { margin: 0; text-align: left; }
.trust-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.trust-card { min-width: 0; min-height: 250px; padding: 24px; border: 1px solid var(--border); border-radius: 8px; background: rgba(15, 23, 42, 0.68); }
.trust-code { display: inline-flex; margin-bottom: 28px; padding: 7px 9px; border: 1px solid rgba(56, 189, 248, 0.22); border-radius: 5px; color: var(--primary); background: rgba(56, 189, 248, 0.07); font-size: 10px; font-weight: 900; }
.trust-card h3 { margin: 0 0 10px; font-size: 18px; }
.trust-card p { margin: 0; color: var(--text-soft); font-size: 13px; line-height: 1.7; }
.trust-link { display: inline-block; margin-top: 14px; color: var(--primary); font-size: 12px; font-weight: 800; }
@media (max-width: 1050px) { .trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 800px) { .trust-heading { grid-template-columns: 1fr; gap: 24px; } }
@media (max-width: 600px) { .trust-grid { grid-template-columns: 1fr; } .trust-card { min-height: 0; } }
</style>
