---
const FLOW = [
  { step: "01", name: "Topic", detail: "A human-curated topic enters the production queue.", status: "Operational" },
  { step: "02", name: "Script", detail: "Narration is drafted inside the bounded production workflow.", status: "Operational" },
  { step: "03", name: "Claims Review", detail: "Wording, links, repeated claims, and factual risk are checked early.", status: "Operational" },
  { step: "04", name: "Scenes", detail: "The script is translated into a structured visual plan.", status: "Operational" },
  { step: "05", slug: "visual", name: "Visuals", detail: "Licensed visual assets are sourced and checked for reuse.", status: "Operational" },
  { step: "06", slug: "voice", name: "Narration", detail: "The approved script is converted into timed spoken audio.", status: "Operational" },
  { step: "07", name: "Captions", detail: "Readable captions are generated and aligned to the narration.", status: "Operational" },
  { step: "08", slug: "music", name: "Music", detail: "A licensed background track is selected and recorded.", status: "Operational" },
  { step: "09", name: "Assembly", detail: "Scenes, narration, captions, and music become a reviewable video.", status: "Operational" },
  { step: "10", slug: "thumbnail", name: "Thumbnail", detail: "A thumbnail is produced and checked against prior concepts.", status: "Operational" },
  { step: "11", slug: "compliance", name: "Compliance", detail: "Licensing and content-risk evidence is gathered for review.", status: "Operational" },
  { step: "12", name: "Human Review", detail: "A person watches, checks, and approves or rejects the finished package.", status: "Human Controlled", checkpoint: true },
  { step: "13", name: "Publishing", detail: "Publishing occurs only after explicit human approval.", status: "Human Controlled", checkpoint: true },
];
---

<section class="agent-ecosystem" id="ecosystem">
  <div class="container">
    <div class="section-center">
      <div class="section-badge">Content Automation</div>
      <h2 class="section-title">Automates production. Keeps publication under human control.</h2>
      <p class="section-subtitle">
        The content system is a real, ordered production pipeline—not a generic autonomous
        agent mesh. Automated stages prepare a reviewable package; the final decision and
        publishing action remain human-controlled.
      </p>
    </div>

    <div class="content-policy">
      <span class="status-pill status-pill--human-controlled">Mandatory checkpoint</span>
      <p>No finished video bypasses human review. Publishing is never treated as an unattended default.</p>
    </div>

    <div class="ecosystem-flow">
      {FLOW.map((node) => (
        <article id={node.slug ? `ecosystem-${node.slug}` : undefined} class:list={["ecosystem-node", { "ecosystem-node--checkpoint": node.checkpoint }]}>
          <div class="ecosystem-node-top">
            <span class="ecosystem-node-marker">{node.step}</span>
            {node.checkpoint ? (
              <span class="status-pill status-pill--human-controlled">{node.status}</span>
            ) : (
              <span class="status-badge status-operational">{node.status}</span>
            )}
          </div>
          <h3>{node.name}</h3>
          <p>{node.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.agent-ecosystem { background: radial-gradient(circle at 15% 10%, rgba(56, 189, 248, 0.07), transparent 32%), linear-gradient(180deg, var(--bg-main), var(--bg-section)); }
.content-policy { display: flex; align-items: center; justify-content: center; gap: 14px; max-width: 840px; margin: 0 auto 34px; padding: 15px 18px; border: 1px solid rgba(129, 140, 248, 0.28); border-radius: 8px; background: rgba(129, 140, 248, 0.06); }
.content-policy p { margin: 0; color: var(--text-soft); font-size: 13px; line-height: 1.6; }
.ecosystem-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.ecosystem-node { min-width: 0; min-height: 210px; padding: 22px; scroll-margin-top: 100px; border: 1px solid var(--border); border-radius: 8px; background: rgba(15, 23, 42, 0.7); box-shadow: var(--shadow-soft); transition: transform 0.25s ease, border-color 0.25s ease; }
.ecosystem-node:hover { transform: translateY(-4px); border-color: var(--border-bright); }
.ecosystem-node--checkpoint { border-color: rgba(129, 140, 248, 0.34); background: rgba(129, 140, 248, 0.07); }
.ecosystem-node-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 22px; }
.ecosystem-node-marker { color: var(--primary); font-size: 12px; font-weight: 900; }
.ecosystem-node h3 { margin: 0 0 10px; font-size: 18px; }
.ecosystem-node p { margin: 0; color: var(--text-soft); font-size: 13.5px; line-height: 1.65; }
.ecosystem-node .status-badge, .ecosystem-node .status-pill { min-height: 28px; padding: 6px 9px; font-size: 9px; }
@media (max-width: 1100px) { .ecosystem-flow { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 780px) { .ecosystem-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .ecosystem-flow { grid-template-columns: 1fr; } .ecosystem-node { min-height: 0; } .content-policy { align-items: flex-start; flex-direction: column; } }
</style>
