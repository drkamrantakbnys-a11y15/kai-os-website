---
const STAGES = [
  { step: "01", title: "Observe", description: "Collect the bounded context a domain needs—conversation, documents, content state, or market data.", boundary: "No evidence means no unsupported claim." },
  { step: "02", title: "Understand", description: "Interpret the request and route it toward the right specialized capability instead of one generic agent.", boundary: "Context and authority stay attached." },
  { step: "03", title: "Plan", description: "Form a task, production sequence, research evaluation, or paper-trading proposal.", boundary: "A plan is not permission to execute." },
  { step: "04", title: "Govern", description: "Apply capability policy, approval requirements, risk limits, pause state, and kill-switch checks.", boundary: "Consequential work fails closed." },
  { step: "05", title: "Act", description: "Execute only where the specific domain is operational and the required gates have passed.", boundary: "Content production and approved paper paths only." },
  { step: "06", title: "Review", description: "Expose results, evidence, warnings, and unresolved decisions to the owner or domain reviewer.", boundary: "Publishing remains a human decision." },
  { step: "07", title: "Learn", description: "Record outcomes, fixes, failures, and evaluation evidence in the relevant persistent memory.", boundary: "Domain memories remain distinct." },
];
---

<section class="how-kai-works" id="how-it-works">
  <div class="container">
    <div class="section-center">
      <div class="section-badge">How KAI Works</div>
      <h2 class="section-title">Intelligence follows a governed lifecycle.</h2>
      <p class="section-subtitle">
        The same discipline runs through each domain: understand first, govern before action,
        surface evidence, and keep learning records close to their source.
      </p>
    </div>

    <div class="lifecycle-grid">
      {STAGES.map((stage) => (
        <article class="lifecycle-card">
          <div class="lifecycle-card-head"><span>{stage.step}</span><span class="lifecycle-line" aria-hidden="true"></span></div>
          <h3>{stage.title}</h3>
          <p>{stage.description}</p>
          <small>{stage.boundary}</small>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.how-kai-works { background: linear-gradient(180deg, var(--bg-section), var(--bg-main)); }
.lifecycle-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
.lifecycle-card { min-width: 0; min-height: 280px; padding: 22px; border: 1px solid var(--border); border-radius: 8px; background: rgba(15, 23, 42, 0.68); }
.lifecycle-card-head { display: flex; align-items: center; gap: 10px; margin-bottom: 34px; }
.lifecycle-card-head > span:first-child { color: var(--primary); font-size: 11px; font-weight: 900; }
.lifecycle-line { height: 1px; flex: 1; background: linear-gradient(90deg, var(--primary), transparent); }
.lifecycle-card h3 { margin: 0 0 14px; font-size: 20px; }
.lifecycle-card p { min-height: 112px; margin: 0 0 20px; color: var(--text-soft); font-size: 13px; line-height: 1.65; }
.lifecycle-card small { display: block; padding-top: 14px; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 11px; line-height: 1.5; }
@media (max-width: 1200px) { .lifecycle-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
@media (max-width: 800px) { .lifecycle-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lifecycle-card p { min-height: 0; } }
@media (max-width: 520px) { .lifecycle-grid { grid-template-columns: 1fr; } .lifecycle-card { min-height: 0; } }
</style>
