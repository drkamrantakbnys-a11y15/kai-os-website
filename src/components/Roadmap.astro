---
const STAGES = [
  {
    label: "Now · Operational",
    tier: "status-operational",
    title: "Working foundations",
    items: [
      "Local conversational interface",
      "English and Hindi voice output",
      "Human-reviewed content production",
      "Mature trading intelligence and Alpaca Paper validation",
      "Persistent memory and orchestration foundations",
    ],
  },
  {
    label: "Next",
    tier: "status-development",
    title: "Controlled product completion",
    items: [
      "Open-market Alpaca Paper certification",
      "Clean continuous paper-learning activation, only after approval",
      "More natural neural conversational voice",
      "Richer Trading Professional interface",
      "Consolidated owner command center",
    ],
  },
  {
    label: "Later",
    tier: "status-planned",
    title: "Governed expansion",
    items: [
      "AI shadow-strategy comparison",
      "Governed AI paper execution",
      "Broader cross-division orchestration",
      "Carefully approved desktop-control capability",
    ],
  },
];
---

<section class="roadmap" id="roadmap">
  <div class="container">
    <div class="section-center">
      <div class="section-badge">Roadmap</div>
      <h2 class="section-title">Now, next, and later—without collapsing the difference.</h2>
      <p class="section-subtitle">Operational work is separated from the next controlled milestone and the longer-term direction. A roadmap item is not a completed capability claim.</p>
    </div>
    <div class="roadmap-grid">
      {STAGES.map((stage, index) => (
        <article class:list={["roadmap-stage", { "roadmap-stage--featured": index === 0 }]}>
          <span class={`status-badge ${stage.tier}`}>{stage.label}</span>
          <h3>{stage.title}</h3>
          <ul>{stage.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.roadmap { background: linear-gradient(180deg, var(--bg-main), var(--bg-section)); }
.roadmap-grid { display: grid; grid-template-columns: 1.1fr 1fr 0.9fr; gap: 20px; }
.roadmap-stage { min-width: 0; padding: 30px; border: 1px solid var(--border); border-radius: 8px; background: rgba(15, 23, 42, 0.68); box-shadow: var(--shadow-soft); }
.roadmap-stage--featured { border-color: rgba(74, 222, 128, 0.25); }
.roadmap-stage h3 { margin: 30px 0 20px; font-size: 24px; }
.roadmap-stage ul { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
.roadmap-stage li { position: relative; padding: 0 0 14px 18px; border-bottom: 1px solid var(--border); color: var(--text-soft); font-size: 14px; line-height: 1.55; }
.roadmap-stage li:last-child { padding-bottom: 0; border-bottom: 0; }
.roadmap-stage li::before { content: ""; position: absolute; top: 8px; left: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--primary); }
@media (max-width: 950px) { .roadmap-grid { grid-template-columns: 1fr; } }
</style>
