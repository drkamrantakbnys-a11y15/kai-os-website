---
import { CHANGELOG } from "../data/changelog.js";
import { DOCUMENTATION_AREAS } from "../data/product.js";
const latest = CHANGELOG[0];

function statusClass(status) {
  return status === "Available" ? "status-operational" : "status-development";
}
---

<section class="documentation" id="documentation">
  <div class="container">
    <div class="documentation-heading">
      <div>
        <div class="section-badge">Public Documentation</div>
        <h2 class="section-title">The product story, with its boundaries intact.</h2>
      </div>
      <div class="documentation-intro">
        <p>
          The public documentation hub explains architecture, capabilities, safety, content,
          voice, paper trading, and roadmap status without publishing private operational detail.
        </p>
        <a href="/docs" class="primary-button">Open Documentation Hub</a>
      </div>
    </div>

    <div class="docs-grid">
      {DOCUMENTATION_AREAS.slice(0, 6).map((doc) => (
        <a href={doc.route} class="doc-card">
          <div><span class={`status-badge ${statusClass(doc.status)}`}>{doc.status}</span><span class="doc-arrow" aria-hidden="true">↗</span></div>
          <h3>{doc.title}</h3>
          <p>{doc.description}</p>
        </a>
      ))}
    </div>

    <div class="evidence-bar">
      <div><span>Latest engineering record</span><strong>{latest.date} · {latest.title}</strong></div>
      <nav aria-label="Public evidence links">
        <a href="/status">Status</a><a href="/changelog">Changelog</a><a href="/knowledge">Knowledge Brain</a>
      </nav>
    </div>
  </div>
</section>

<style>
.documentation { background: radial-gradient(circle at 75% 10%, rgba(56, 189, 248, 0.06), transparent 32%), linear-gradient(180deg, var(--bg-section), var(--bg-main)); }
.documentation-heading { display: grid; grid-template-columns: 1fr 0.75fr; gap: 70px; align-items: end; margin-bottom: 56px; }
.documentation-heading .section-title { margin-bottom: 0; }
.documentation-intro p { margin: 0 0 24px; color: var(--text-soft); font-size: 15px; line-height: 1.75; }
.docs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.doc-card { min-width: 0; min-height: 230px; padding: 24px; border: 1px solid var(--border); border-radius: 8px; background: rgba(15, 23, 42, 0.68); transition: transform 0.25s ease, border-color 0.25s ease; }
.doc-card:hover { transform: translateY(-4px); border-color: var(--border-bright); }
.doc-card > div { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.doc-arrow { color: var(--primary); font-size: 20px; }
.doc-card h3 { margin: 30px 0 12px; font-size: 18px; }
.doc-card p { margin: 0; color: var(--text-soft); font-size: 13px; line-height: 1.65; }
.evidence-bar { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 22px; padding: 22px 24px; border: 1px solid var(--border); border-radius: 8px; background: rgba(2, 6, 23, 0.52); }
.evidence-bar div { display: grid; gap: 6px; }
.evidence-bar span { color: var(--text-muted); font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.08em; }
.evidence-bar strong { font-size: 13px; }
.evidence-bar nav { display: flex; gap: 18px; flex-wrap: wrap; }
.evidence-bar a { color: var(--primary); font-size: 12px; font-weight: 800; }
@media (max-width: 1000px) { .documentation-heading { grid-template-columns: 1fr; gap: 24px; } .docs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 700px) { .docs-grid { grid-template-columns: 1fr; } .doc-card { min-height: 0; } .evidence-bar { align-items: flex-start; flex-direction: column; } }
</style>
