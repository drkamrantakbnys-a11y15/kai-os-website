---
import { PRODUCT_CAPABILITIES } from "../data/product.js";
---

<section class="capabilities" id="capabilities">
  <div class="container">
    <div class="section-center">
      <div class="section-badge">Verified Capabilities</div>
      <h2 class="section-title">What KAI can do today.</h2>
      <p class="section-subtitle">
        The product is presented by evidence level, not ambition. Every capability below is
        labeled Operational or In Development so a working subsystem is never confused with a
        complete autonomous experience.
      </p>
    </div>

    <div class="capability-grid">
      {PRODUCT_CAPABILITIES.map((capability) => (
        <article class="capability-card">
          <div class="capability-card-top">
            <span class="capability-code" aria-hidden="true">{capability.code}</span>
            <span class={`status-badge ${capability.tier}`}>{capability.status}</span>
          </div>
          <h3>{capability.title}</h3>
          <p>{capability.summary}</p>
          <ul>
            {capability.points.map((point) => <li>{point}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.capabilities {
  background:
    radial-gradient(circle at 88% 12%, rgba(56, 189, 248, 0.08), transparent 30%),
    linear-gradient(180deg, var(--bg-main), var(--bg-section));
}

.capability-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.capability-card {
  min-width: 0;
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.76), rgba(8, 17, 31, 0.72));
  box-shadow: var(--shadow-soft);
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.capability-card:hover {
  transform: translateY(-5px);
  border-color: var(--border-bright);
}

.capability-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 24px;
}

.capability-code {
  display: grid;
  place-items: center;
  width: 54px;
  height: 38px;
  border: 1px solid rgba(56, 189, 248, 0.24);
  border-radius: 6px;
  color: var(--primary);
  background: rgba(56, 189, 248, 0.08);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.06em;
}

.capability-card h3 {
  margin: 0 0 12px;
  font-size: 18px;
}

.capability-card p {
  min-height: 76px;
  margin: 0 0 18px;
  color: var(--text-soft);
  font-size: 14.5px;
  line-height: 1.7;
}

.capability-card ul {
  display: grid;
  gap: 9px;
  margin: 0;
  padding: 16px 0 0;
  border-top: 1px solid var(--border);
  list-style: none;
}

.capability-card li {
  position: relative;
  padding-left: 16px;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.5;
}

.capability-card li::before {
  content: "";
  position: absolute;
  top: 8px;
  left: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--primary);
}

@media (max-width: 1050px) {
  .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 650px) {
  .capability-grid { grid-template-columns: 1fr; }
  .capability-card p { min-height: 0; }
}
</style>
