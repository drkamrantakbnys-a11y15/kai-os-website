---
const AREAS = [
  { code: "SYS", title: "AI Systems", detail: "Agent boundaries, policy, task lifecycles, orchestration, and local-first interaction." },
  { code: "AUTO", title: "Automation", detail: "Repeatable workflows with clear human checkpoints and auditable outcomes." },
  { code: "QNT", title: "Trading Research", detail: "Strategy evaluation, simulation, backtesting, risk, and paper-only brokerage validation." },
  { code: "MEM", title: "Memory Systems", detail: "Decision records, knowledge, failures, outcomes, and evidence-aware retrieval." },
  { code: "DATA", title: "Analytics", detail: "Structured evaluation and reporting, with disconnected or incomplete data clearly labeled." },
  { code: "SAFE", title: "Safety", detail: "Approval gates, capability limits, auditability, stop controls, and responsible expansion." },
];
---

<section class="research" id="research">
  <div class="container">
    <div class="research-heading">
      <div><div class="section-badge">Research &amp; Analytics</div><h2 class="section-title">Research that has to survive contact with evidence.</h2></div>
      <p class="section-subtitle">KAI's research layer is built around documented experiments, simulations, system reports, and explicit limitations—not a claim that every idea is already automated.</p>
    </div>
    <div class="research-grid">
      {AREAS.map((area) => <article class="research-card"><span>{area.code}</span><h3>{area.title}</h3><p>{area.detail}</p></article>)}
    </div>
    <div class="research-actions"><a href="/research" class="secondary-button">Explore Research</a><a href="/knowledge" class="secondary-button">Open Knowledge Brain</a></div>
  </div>
</section>

<style>
.research { background: linear-gradient(180deg, var(--bg-section), var(--bg-main)); }
.research-heading { display: grid; grid-template-columns: 1fr 0.75fr; gap: 70px; align-items: end; margin-bottom: 56px; }
.research-heading .section-title { margin-bottom: 0; }
.research-heading .section-subtitle { margin: 0; text-align: left; }
.research-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.research-card { min-width: 0; padding: 24px; border: 1px solid var(--border); border-radius: 8px; background: rgba(15, 23, 42, 0.64); }
.research-card > span { color: var(--primary); font-size: 10px; font-weight: 900; }
.research-card h3 { margin: 28px 0 10px; font-size: 18px; }
.research-card p { margin: 0; color: var(--text-soft); font-size: 13px; line-height: 1.65; }
.research-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
@media (max-width: 900px) { .research-heading { grid-template-columns: 1fr; gap: 24px; } .research-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .research-grid { grid-template-columns: 1fr; } }
</style>
