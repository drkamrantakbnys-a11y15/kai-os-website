---
import kaiOsData from "../data/generated/kai-os-public-data.json";
const totalSystems = kaiOsData.agents.total_capabilities;
---

<section class="stats" id="stats" aria-label="Verified Project KAI status">
  <div class="container"><div class="stats-panel">
    <div class="stat-card"><span class="stat-number">{totalSystems}</span><div><h2>Declared agent roles</h2><p>Capability and autonomy status are shown separately.</p></div></div>
    <div class="stat-card"><span class="stat-number stat-number--word">Local</span><div><h2>Processing first</h2><p>Conversation and core runtime paths prioritize the owner's environment.</p></div></div>
    <div class="stat-card"><span class="stat-number stat-number--word">Human</span><div><h2>Reviewed</h2><p>Consequential publishing and activation decisions stay explicitly gated.</p></div></div>
    <div class="stat-card stat-card--paper"><span class="stat-number stat-number--word">Paper</span><div><h2>Trading boundary</h2><p>Alpaca validation is paper-only; continuous execution remains disabled.</p></div></div>
  </div></div>
</section>

<style>
.stats { z-index: 3; margin-top: -48px; padding: 0 24px 96px; background: transparent; }
.stats-panel { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid rgba(56, 189, 248, 0.22); border-radius: 8px; background: rgba(5, 11, 24, 0.9); box-shadow: 0 28px 90px rgba(0, 0, 0, 0.32); overflow: hidden; }
.stat-card { display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start; min-width: 0; padding: 24px; border-right: 1px solid var(--border); }
.stat-card:last-child { border-right: 0; }
.stat-card--paper { background: rgba(56, 189, 248, 0.035); }
.stat-number { color: var(--primary); font-size: 30px; font-weight: 900; line-height: 1; }
.stat-number--word { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; }
.stat-card h2 { margin: 0 0 6px; font-size: 15px; }
.stat-card p { margin: 0; color: var(--text-muted); font-size: 12px; line-height: 1.55; }
@media (max-width: 1050px) { .stats-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); } .stat-card:nth-child(2) { border-right: 0; } .stat-card:nth-child(-n+2) { border-bottom: 1px solid var(--border); } }
@media (max-width: 600px) { .stats { margin-top: 0; padding: 0 18px 72px; } .stats-panel { grid-template-columns: 1fr; } .stat-card { border-right: 0; border-bottom: 1px solid var(--border); } .stat-card:nth-child(3) { border-bottom: 1px solid var(--border); } .stat-card:last-child { border-bottom: 0; } }
</style>
