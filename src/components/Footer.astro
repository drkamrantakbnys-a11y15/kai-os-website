---
import SurpriseMeButton from "./SurpriseMeButton.astro";
---
<footer class="footer">
  <div class="container footer-grid">

    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark">◉</span>
        <span>Project KAI</span>
      </a>

      <p>
        Project KAI is an AI, technology, and discovery media platform -- news, future radar,
        experiments, reviews, and education -- powered by KAI OS, its modular AI operating system
        for automation, research, and content creation.
      </p>

      <div class="footer-surprise">
        <SurpriseMeButton />
      </div>
    </div>

    <div class="footer-column">
      <h4>Platform</h4>
      <a href="/">Home</a>
      <a href="/command-center">Command Center</a>
      <a href="/about">About</a>
      <a href="/#how-it-works">How It Works</a>
      <a href="/agents">Agents</a>
      <a href="/agent-builder">Agent Builder</a>
      <a href="/analytics">Analytics</a>
      <a href="/search">Search</a>
      <a href="/#trust">Trust</a>
      <a href="/#roadmap">Roadmap</a>
    </div>

    <div class="footer-column">
      <h4>Media Network</h4>
      <a href="/media">Media Network Hub</a>
      <a href="/learn">Learn</a>
      <a href="/discover">Discover</a>
      <a href="/future-radar">Future Radar</a>
      <a href="/ai-news">AI News</a>
      <a href="/experiments">Experiments</a>
      <a href="/reviews">Reviews</a>
      <a href="/fun-facts">AI Fun Facts</a>
      <a href="/ai-jokes">AI Jokes</a>
      <a href="/saved">Saved</a>
    </div>

    <div class="footer-column">
      <h4>Resources</h4>
      <a href="/blog">Blog</a>
      <a href="/research">Research</a>
      <a href="/#features">Features</a>
      <a href="/docs">Documentation</a>
      <a href="/status">System Status</a>
      <a href="/security">Security</a>
      <a href="/desktop-operator">Desktop Operator</a>
      <a href="/changelog">Changelog</a>
      <a href="/knowledge">Knowledge Brain</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-column">
      <h4>Legal</h4>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms</a>
    </div>

  </div>

  <div class="container footer-bottom">
    <p>© 2026 Project KAI. Built by Kamran Tak.</p>
  </div>
</footer>

<style>
.footer {
  padding: 80px 24px 30px;
  background: #020617;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
  gap: 40px;
}

.footer-surprise {
  margin-top: 24px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: white;
  font-weight: 900;
  font-size: 22px;
}

.brand-mark {
  color: var(--primary);
}

.footer-brand p {
  max-width: 420px;
  margin-top: 20px;
  color: var(--text-soft);
  line-height: 1.8;
}

.footer-column {
  display: grid;
  gap: 12px;
  align-content: start;
}

.footer-column h4 {
  margin: 0 0 8px;
  color: white;
}

.footer-column a {
  color: var(--text-muted);
  font-size: 15px;
}

.footer-column a:hover {
  color: var(--primary);
}

.footer-bottom {
  margin-top: 60px;
  padding-top: 24px;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.footer-bottom p {
  color: var(--text-muted);
  font-size: 14px;
}

@media(max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media(max-width: 600px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }
}
</style>
