---
// Click-to-play KAI Vision experience. Triggered by any element carrying
// [data-open-vision-modal] (see Hero.astro's primary CTA) -- never opens
// on its own, never on page load, never remembers to reopen across visits.
// Uses native <video controls> (play/pause, mute/volume, fullscreen,
// captions-track toggle all come free, fully accessible, zero extra
// dependency) plus a small amount of custom script for: the click-to-open
// gate itself, a real Close control (native video has none), Escape-to-
// close, focus management, and the post-video "Talk to KAI" handoff.
// See public/media/vision/README.md for the real video drop-in location
// and PROJECT_KAI_FOUNDER_VISION_EXPERIENCE.md for the full design writeup.
import { FOUNDER_VISION_SCRIPT_PARAGRAPHS } from "../data/founderVisionScript.js";
---

<div class="vision-modal" id="vision-modal" hidden aria-hidden="true">
  <div class="vision-modal-backdrop" data-close-vision-modal></div>
  <div
    class="vision-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="vision-modal-title"
    id="vision-modal-dialog"
  >
    <h2 id="vision-modal-title" class="sr-only">The KAI Vision</h2>

    <button type="button" class="vision-modal-close" data-close-vision-modal aria-label="Close video">
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="vision-video-frame">
      <video
        id="vision-video"
        controls
        playsinline
        preload="metadata"
        poster="/media/vision/kai-vision-poster.jpg"
      >
        <source src="/media/vision/kai-vision.mp4" type="video/mp4" />
        <track
          kind="captions"
          src="/media/vision/kai-vision-captions.vtt"
          srclang="en"
          label="English"
          default
        />
        Your browser does not support embedded video. The KAI Vision film will be available at
        <a href="/media/vision/kai-vision.mp4">this direct link</a> once published.
      </video>

      <div class="vision-video-unavailable" id="vision-video-unavailable" hidden>
        <span class="section-badge">Coming Soon</span>
        <p>The KAI Vision film is still in production. This player is fully wired and will start
          working the moment the final video is published — nothing else on the site needs to
          change.</p>
        <details class="vision-script-details">
          <summary>Read the approved script</summary>
          <div class="vision-script-text">
            {FOUNDER_VISION_SCRIPT_PARAGRAPHS.map((line) => <p>{line}</p>)}
          </div>
        </details>
      </div>
    </div>

    <div class="vision-post-video" id="vision-post-video" hidden>
      <p class="vision-post-line">That is the vision.<br /><span>Now meet the intelligence we're building.</span></p>
      <a href="/kai" class="primary-button vision-talk-button">&#10022; Talk to KAI</a>
    </div>
  </div>
</div>

<style>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.vision-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.vision-modal[hidden] {
  display: none;
}

.vision-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.86);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.vision-modal-dialog {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 980px;
  max-height: 92vh;
  overflow: auto;
  border-radius: 16px;
  border: 1px solid rgba(56, 189, 248, 0.3);
  background: linear-gradient(180deg, rgba(8, 17, 31, 0.98), rgba(5, 11, 24, 0.98));
  box-shadow: 0 40px 140px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(56, 189, 248, 0.08);
  padding: 18px;
}

.vision-modal-close {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: rgba(2, 6, 23, 0.7);
  color: var(--text-main);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: 0.2s ease;
}

.vision-modal-close:hover,
.vision-modal-close:focus-visible {
  border-color: var(--border-bright);
  color: var(--primary);
}

.vision-video-frame {
  position: relative;
  border-radius: 10px;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(56, 189, 248, 0.14), transparent 40%),
    radial-gradient(circle at 80% 80%, rgba(129, 140, 248, 0.1), transparent 38%),
    #030711;
  aspect-ratio: 16 / 9;
}

#vision-video {
  width: 100%;
  height: 100%;
  display: block;
  background: #030711;
}

.vision-video-unavailable {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  text-align: center;
  padding: 32px;
}

.vision-video-unavailable[hidden] {
  display: none;
}

.vision-video-unavailable p {
  max-width: 460px;
  margin: 0;
  color: var(--text-soft);
  font-size: 14px;
  line-height: 1.7;
}

.vision-script-details {
  max-width: 460px;
  width: 100%;
  text-align: left;
}

.vision-script-details summary {
  cursor: pointer;
  color: var(--primary);
  font-size: 12.5px;
  font-weight: 700;
  text-align: center;
  list-style: none;
}
.vision-script-details summary::-webkit-details-marker { display: none; }
.vision-script-details summary:hover { text-decoration: underline; }

.vision-script-text {
  margin-top: 12px;
  max-height: 180px;
  overflow-y: auto;
  padding: 14px 16px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: rgba(2, 6, 23, 0.4);
}
.vision-script-text p {
  max-width: none;
  margin: 0 0 10px;
  color: var(--text-muted);
  font-size: 12.5px;
  line-height: 1.7;
}
.vision-script-text p:last-child { margin-bottom: 0; }

.vision-post-video {
  margin-top: 22px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  text-align: center;
}

.vision-post-video[hidden] {
  display: none;
}

.vision-post-line {
  margin: 0 0 20px;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-soft);
  line-height: 1.5;
}

.vision-post-line span {
  color: var(--text-main);
  font-size: 24px;
}

.vision-talk-button {
  display: inline-flex;
}

@media (max-width: 700px) {
  .vision-modal { padding: 0; }
  .vision-modal-dialog { max-width: 100%; max-height: 100vh; height: 100%; border-radius: 0; overflow-y: auto; }
  .vision-video-frame { aspect-ratio: auto; min-height: 220px; }
  .vision-post-line { font-size: 17px; }
  .vision-post-line span { font-size: 19px; }
}

@media (prefers-reduced-motion: reduce) {
  .vision-modal-backdrop {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
}
</style>

<script>
  (function initVisionModal() {
    const modal = document.getElementById("vision-modal");
    const dialog = document.getElementById("vision-modal-dialog");
    const video = document.getElementById("vision-video") as HTMLVideoElement | null;
    const unavailable = document.getElementById("vision-video-unavailable");
    const postVideo = document.getElementById("vision-post-video");
    const closeButtons = document.querySelectorAll("[data-close-vision-modal]");
    const openTriggers = document.querySelectorAll("[data-open-vision-modal]");

    if (!modal || !dialog || !video) return;

    let lastFocusedElement: HTMLElement | null = null;

    function openModal() {
      lastFocusedElement = document.activeElement as HTMLElement | null;
      modal!.hidden = false;
      modal!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      postVideo!.hidden = true;

      // Escape-to-close and focus trapping must work regardless of whether
      // the video itself loaded -- the modal, its Close button, and its
      // backdrop are always interactive, so these attach unconditionally.
      const closeBtn = dialog!.querySelector<HTMLButtonElement>(".vision-modal-close");
      closeBtn?.focus();
      document.addEventListener("keydown", onKeydown);
      dialog!.addEventListener("keydown", trapFocus);

      // preload="metadata" makes the browser start resolving the source
      // as soon as the element parses -- on a real 404 this can fail (and
      // fire 'error') before this script's own listener has attached,
      // so a live 'error' event alone is not reliable. checkVideoHealth()
      // (registered as the 'error' listener AND called here) re-checks
      // the element's current state every time the modal opens, so a
      // failure that already happened is still caught.
      if (checkVideoHealth()) return;

      // Playback only ever starts here, inside a real click handler --
      // never on load, never automatically. No `autoplay` attribute
      // exists on the element at all.
      const playAttempt = video!.play();
      if (playAttempt && typeof playAttempt.catch === "function") {
        playAttempt.catch(() => {
          // Autoplay-with-sound can still be blocked by some browsers even
          // on a user gesture in rare cases (e.g. a synthetic click) --
          // the native controls remain fully usable either way, so this
          // is not treated as an error state.
        });
      }
    }

    function closeModal() {
      video!.pause();
      modal!.hidden = true;
      modal!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeydown);
      dialog!.removeEventListener("keydown", trapFocus);
      // Never auto-reopens: closing simply hides the modal. Nothing is
      // written to storage to "remember" to show it again -- it only
      // ever opens from an explicit click on the trigger button.
      lastFocusedElement?.focus();
    }

    function onKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        event.preventDefault();
        closeModal();
      }
    }

    function trapFocus(event: KeyboardEvent) {
      if (event.key !== "Tab") return;
      const focusable = dialog!.querySelectorAll<HTMLElement>(
        'button, [href], video, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function checkVideoHealth(): boolean {
      // True (and shows the honest "coming soon" message) if the source
      // has already failed to resolve -- covers both a live 'error' event
      // and the case where it failed before this script attached (see the
      // call site in openModal()). NETWORK_NO_SOURCE (3) is the terminal
      // state for "no working <source> was found", the exact case a
      // missing kai-vision.mp4 produces.
      const failed = Boolean(video!.error) || video!.networkState === HTMLMediaElement.NETWORK_NO_SOURCE;
      if (failed) {
        unavailable!.hidden = false;
        video!.style.display = "none";
      }
      return failed;
    }

    video.addEventListener("error", checkVideoHealth);

    video.addEventListener("ended", () => {
      postVideo!.hidden = false;
      postVideo!.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    openTriggers.forEach((trigger) => trigger.addEventListener("click", openModal));
    closeButtons.forEach((btn) => btn.addEventListener("click", closeModal));
  })();
</script>
