---
// Click-to-play KAI Vision experience. Triggered by any element carrying
// [data-open-vision-modal] (see Hero.astro's primary CTA) -- never opens
// on its own, never on page load, never remembers to reopen across visits.
//
// Founder Vision v1 is published on the Project KAI YouTube channel, so
// this embeds the youtube-nocookie.com privacy-enhanced player rather than
// self-hosting the source file -- nothing under private_media/ is ever
// served publicly. The iframe itself is only created inside openModal()
// (a real click handler), never on page load, so autoplay only ever
// follows a genuine user gesture -- same rule the previous native-video
// version followed. Closing the modal tears the iframe down entirely
// (rather than just hiding it) so playback actually stops.
//
// See PROJECT_KAI_FOUNDER_VISION_EXPERIENCE.md for the full design writeup.
import { FOUNDER_VISION_SCRIPT_PARAGRAPHS } from "../data/founderVisionScript.js";

const YOUTUBE_VIDEO_ID = "GVwyxoZkktM";
---

<div class="vision-modal" id="vision-modal" hidden aria-hidden="true">
  <div class="vision-modal-backdrop" data-close-vision-modal></div>
  <div
    class="vision-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="vision-modal-title"
    id="vision-modal-dialog"
  >
    <h2 id="vision-modal-title" class="sr-only">The KAI Vision</h2>

    <button type="button" class="vision-modal-close" data-close-vision-modal aria-label="Close video">
      <span aria-hidden="true">&times;</span>
    </button>

    <div
      class="vision-video-frame"
      id="vision-video-frame"
      style={`background-image:url('https://i.ytimg.com/vi/${YOUTUBE_VIDEO_ID}/maxresdefault.jpg')`}
    >
      <div id="vision-video-mount" data-video-id={YOUTUBE_VIDEO_ID}></div>

      <div class="vision-video-unavailable" id="vision-video-unavailable" hidden>
        <span class="section-badge">Player Unavailable</span>
        <p>The video couldn't load right now. You can watch it directly on
          YouTube: <a href={`https://youtu.be/${YOUTUBE_VIDEO_ID}`} target="_blank" rel="noopener noreferrer">youtu.be/{YOUTUBE_VIDEO_ID}</a>,
          or read the approved script below.</p>
        <details class="vision-script-details">
          <summary>Read the approved script</summary>
          <div class="vision-script-text">
            {FOUNDER_VISION_SCRIPT_PARAGRAPHS.map((line) => <p>{line}</p>)}
          </div>
        </details>
      </div>
    </div>

    <div class="vision-post-video" id="vision-post-video" hidden>
      <p class="vision-post-line">That is the vision.<br /><span>Now meet the intelligence we're building.</span></p>
      <a href="/kai" class="primary-button vision-talk-button">&#10022; Talk to KAI</a>
    </div>
  </div>
</div>

<style>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.vision-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.vision-modal[hidden] {
  display: none;
}

.vision-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.86);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.vision-modal-dialog {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 980px;
  max-height: 92vh;
  overflow: auto;
  border-radius: 16px;
  border: 1px solid rgba(56, 189, 248, 0.3);
  background: linear-gradient(180deg, rgba(8, 17, 31, 0.98), rgba(5, 11, 24, 0.98));
  box-shadow: 0 40px 140px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(56, 189, 248, 0.08);
  padding: 18px;
}

.vision-modal-close {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: rgba(2, 6, 23, 0.7);
  color: var(--text-main);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: 0.2s ease;
}

.vision-modal-close:hover,
.vision-modal-close:focus-visible {
  border-color: var(--border-bright);
  color: var(--primary);
}

.vision-video-frame {
  position: relative;
  border-radius: 10px;
  overflow: hidden;
  background-color: #030711;
  background-size: cover;
  background-position: center;
  aspect-ratio: 16 / 9;
}

#vision-video-mount {
  width: 100%;
  height: 100%;
}

#vision-video-mount iframe {
  width: 100%;
  height: 100%;
  display: block;
  border: 0;
}

.vision-video-unavailable {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  text-align: center;
  padding: 32px;
}

.vision-video-unavailable[hidden] {
  display: none;
}

.vision-video-unavailable p {
  max-width: 460px;
  margin: 0;
  color: var(--text-soft);
  font-size: 14px;
  line-height: 1.7;
}

.vision-script-details {
  max-width: 460px;
  width: 100%;
  text-align: left;
}

.vision-script-details summary {
  cursor: pointer;
  color: var(--primary);
  font-size: 12.5px;
  font-weight: 700;
  text-align: center;
  list-style: none;
}
.vision-script-details summary::-webkit-details-marker { display: none; }
.vision-script-details summary:hover { text-decoration: underline; }

.vision-script-text {
  margin-top: 12px;
  max-height: 180px;
  overflow-y: auto;
  padding: 14px 16px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: rgba(2, 6, 23, 0.4);
}
.vision-script-text p {
  max-width: none;
  margin: 0 0 10px;
  color: var(--text-muted);
  font-size: 12.5px;
  line-height: 1.7;
}
.vision-script-text p:last-child { margin-bottom: 0; }

.vision-post-video {
  margin-top: 22px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  text-align: center;
}

.vision-post-video[hidden] {
  display: none;
}

.vision-post-line {
  margin: 0 0 20px;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-soft);
  line-height: 1.5;
}

.vision-post-line span {
  color: var(--text-main);
  font-size: 24px;
}

.vision-talk-button {
  display: inline-flex;
}

@media (max-width: 700px) {
  .vision-modal { padding: 0; }
  .vision-modal-dialog { max-width: 100%; max-height: 100vh; height: 100%; border-radius: 0; overflow-y: auto; }
  .vision-video-frame { aspect-ratio: auto; min-height: 220px; }
  .vision-post-line { font-size: 17px; }
  .vision-post-line span { font-size: 19px; }
}

@media (prefers-reduced-motion: reduce) {
  .vision-modal-backdrop {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
}
</style>

<script>
  (function initVisionModal() {
    const modal = document.getElementById("vision-modal");
    const dialog = document.getElementById("vision-modal-dialog");
    const mount = document.getElementById("vision-video-mount") as HTMLDivElement | null;
    const unavailable = document.getElementById("vision-video-unavailable");
    const postVideo = document.getElementById("vision-post-video");
    const closeButtons = document.querySelectorAll("[data-close-vision-modal]");
    const openTriggers = document.querySelectorAll("[data-open-vision-modal]");

    if (!modal || !dialog || !mount) return;

    const videoId = mount.dataset.videoId;
    let lastFocusedElement: HTMLElement | null = null;
    let player: any = null;
    let apiLoadFailedTimer: ReturnType<typeof setTimeout> | null = null;

    // Loaded once, lazily, on first open -- never on page load. The
    // YouTube IFrame API is what gives us a real 'ended' event (a plain
    // <iframe src="...embed/ID"> has no such signal) and lets us destroy
    // playback cleanly on close.
    function loadYouTubeApiOnce(): Promise<any> {
      const w = window as any;
      if (w.YT && w.YT.Player) return Promise.resolve(w.YT);
      if (w.__kaiVisionYtApiPromise) return w.__kaiVisionYtApiPromise;
      w.__kaiVisionYtApiPromise = new Promise((resolve, reject) => {
        const prevReady = w.onYouTubeIframeAPIReady;
        w.onYouTubeIframeAPIReady = () => {
          prevReady?.();
          resolve(w.YT);
        };
        const tag = document.createElement("script");
        tag.src = "https://www.youtube.com/iframe_api";
        tag.onerror = () => reject(new Error("YouTube IFrame API failed to load"));
        document.head.appendChild(tag);
      });
      return w.__kaiVisionYtApiPromise;
    }

    function showUnavailable() {
      unavailable!.hidden = false;
      mount!.style.display = "none";
    }

    function openModal() {
      lastFocusedElement = document.activeElement as HTMLElement | null;
      modal!.hidden = false;
      modal!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      postVideo!.hidden = true;
      unavailable!.hidden = true;
      mount!.style.display = "";

      const closeBtn = dialog!.querySelector<HTMLButtonElement>(".vision-modal-close");
      closeBtn?.focus();
      document.addEventListener("keydown", onKeydown);
      dialog!.addEventListener("keydown", trapFocus);

      if (!videoId) {
        showUnavailable();
        return;
      }

      // A slow/blocked API load (ad blockers, offline) shouldn't leave a
      // silently empty player forever -- fall back to the honest message.
      apiLoadFailedTimer = setTimeout(showUnavailable, 8000);

      loadYouTubeApiOnce()
        .then((YT) => {
          if (apiLoadFailedTimer) clearTimeout(apiLoadFailedTimer);
          // Re-check: the visitor may have already closed the modal while
          // the API script was still loading.
          if (modal!.hidden) return;
          player = new YT.Player(mount, {
            videoId,
            playerVars: {
              autoplay: 1, // only ever reached inside this click-triggered openModal()
              rel: 0,
              modestbranding: 1,
              playsinline: 1,
              origin: window.location.origin,
            },
            host: "https://www.youtube-nocookie.com",
            events: {
              onStateChange: (e: any) => {
                if (e.data === YT.PlayerState.ENDED) {
                  postVideo!.hidden = false;
                  postVideo!.scrollIntoView({ behavior: "smooth", block: "nearest" });
                }
              },
              onError: () => showUnavailable(),
            },
          });
        })
        .catch(() => {
          if (apiLoadFailedTimer) clearTimeout(apiLoadFailedTimer);
          showUnavailable();
        });
    }

    function closeModal() {
      // Tear the player down entirely (not just hide it) so playback and
      // audio actually stop the moment the modal closes.
      if (apiLoadFailedTimer) clearTimeout(apiLoadFailedTimer);
      if (player && typeof player.destroy === "function") {
        player.destroy();
      }
      player = null;
      mount!.replaceChildren();

      modal!.hidden = true;
      modal!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeydown);
      dialog!.removeEventListener("keydown", trapFocus);
      // Never auto-reopens: closing simply hides the modal. Nothing is
      // written to storage to "remember" to show it again -- it only
      // ever opens from an explicit click on the trigger button.
      lastFocusedElement?.focus();
    }

    function onKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        event.preventDefault();
        closeModal();
      }
    }

    function trapFocus(event: KeyboardEvent) {
      if (event.key !== "Tab") return;
      const focusable = dialog!.querySelectorAll<HTMLElement>(
        'button, [href], iframe, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    openTriggers.forEach((trigger) => trigger.addEventListener("click", openModal));
    closeButtons.forEach((btn) => btn.addEventListener("click", closeModal));
  })();
</script>
